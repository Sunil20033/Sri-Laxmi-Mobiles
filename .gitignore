# ==========================================
# Sri Laxmi Mobiles - Root Git Ignore
# ==========================================

# Frontend
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

# Frontend environment files
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Backend
backend/target/
backend/.env

# Java / Maven
*.class
*.jar
*.war
*.log

# IDE
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*.bak

# Node / npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example